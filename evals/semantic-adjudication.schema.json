{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/eval-semantic-adjudication.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "judge_performed",
    "candidate_sha256",
    "requested_configuration",
    "fixtures",
    "aggregate",
    "overall_verdict",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "judge_performed": {
      "const": true
    },
    "candidate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requested_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "mode",
        "fork_turns",
        "leaf_only"
      ],
      "properties": {
        "model": {
          "const": "gpt-5.6-sol"
        },
        "mode": {
          "const": "ultra"
        },
        "fork_turns": {
          "const": "none"
        },
        "leaf_only": {
          "const": true
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_count",
        "pass_count",
        "fail_count",
        "required_obligation_count",
        "matched_obligation_count",
        "prohibited_retained_count"
      ],
      "properties": {
        "fixture_count": {
          "type": "integer",
          "minimum": 1
        },
        "pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_obligation_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_obligation_count": {
          "type": "integer",
          "minimum": 0
        },
        "prohibited_retained_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "overall_verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "required_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_finding_id",
        "matched_candidate_finding_ids",
        "semantic_match",
        "evidence"
      ],
      "properties": {
        "oracle_finding_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "matched_candidate_finding_ids": {
          "$ref": "#/$defs/string_list"
        },
        "semantic_match": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\S"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "required_matches",
        "prohibited_retained",
        "hard_expectation_failures",
        "other_hard_gate_failures",
        "oracle_contract_issues",
        "verdict"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "required_matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required_match"
          }
        },
        "prohibited_retained": {
          "$ref": "#/$defs/string_list"
        },
        "hard_expectation_failures": {
          "$ref": "#/$defs/string_list"
        },
        "other_hard_gate_failures": {
          "$ref": "#/$defs/string_list"
        },
        "oracle_contract_issues": {
          "$ref": "#/$defs/string_list"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    }
  }
}
