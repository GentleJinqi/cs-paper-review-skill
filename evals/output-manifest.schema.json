{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/eval-output-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "compatibility_payload_sha256",
    "fixture_set",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "compatibility_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fixture_set": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "locator",
        "sha256",
        "privacy",
        "role"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "privacy": {
          "enum": [
            "public",
            "private-reference"
          ]
        },
        "role": {
          "enum": [
            "aggregate-result",
            "adapter-selection",
            "closure-record",
            "external-mechanism-evidence"
          ]
        }
      }
    }
  }
}
