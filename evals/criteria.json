    "valid_run_and_finding_contracts",
    "valid_venue_profile_and_native_fields",
    "truthful_partial_or_blocked_state"
  ],
  "diagnostics": [
    "supported_finding_precision",
    "source_anchor_accuracy",
    "method_manuscript_understanding",
    "decision_impact_calibration",
    "native_form_fidelity",
    "delta_status_accuracy",
    "dissent_preservation",
    "duplicate_candidate_rate_after_adjudication",
    "closure_actionability",
    "artifact_completeness",
    "token_tool_time_observations"
