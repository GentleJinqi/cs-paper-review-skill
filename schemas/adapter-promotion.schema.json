{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/adapter-promotion.schema.json",
  "title": "Adapter promotion record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "evaluated_at",
    "candidate_id",
    "adapter_sha256",
    "compatibility_payload_sha256",
    "result",
    "promotion_decision",
    "evaluation_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_id": {
      "enum": [
        "minimal-settled-set",
        "persisted-task-registry"
      ]
    },
    "adapter_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "compatibility_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "promotion_decision": {
      "enum": [
        "selected",
        "not_selected",
        "rejected"
      ]
    },
    "evaluation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_set",
        "fixture_manifest_locator",
        "fixture_manifest_sha256",
        "candidate_evaluations",
        "semantic_review_locator",
        "semantic_review_sha256",
        "quality_result",
        "lifecycle_result"
      ],
      "properties": {
        "fixture_set": {
          "type": "string",
          "minLength": 1
        },
        "fixture_manifest_locator": {
          "type": "string",
          "minLength": 1
        },
        "fixture_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_evaluations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "candidate_implementation_sha256",
              "execution_receipt_locator",
              "execution_receipt_sha256",
              "evaluation_report_locator",
              "evaluation_report_sha256",
              "quality_result",
              "lifecycle_result"
            ],
            "properties": {
              "candidate_id": {
                "enum": [
                  "minimal-settled-set",
                  "persisted-task-registry"
                ]
              },
              "candidate_implementation_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "execution_receipt_locator": {
                "type": "string",
                "minLength": 1
              },
              "execution_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "evaluation_report_locator": {
                "type": "string",
                "minLength": 1
              },
              "evaluation_report_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "quality_result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "lifecycle_result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          }
        },
        "semantic_review_locator": {
          "type": "string",
          "minLength": 1
        },
        "semantic_review_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "quality_result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "lifecycle_result": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
