{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/run-manifest.schema.json",
  "title": "Scientific review run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "review_goal",
    "review_kind",
    "authorisation",
    "confidentiality",
    "review_only",
    "input_artifacts",
    "source_pdf_alignment",
    "target",
    "venue_profile",
    "runtime_profile",
    "delegation",
    "coverage",
    "stages",
    "output_artifacts",
    "completion",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_goal": {
      "type": "string",
      "minLength": 1
    },
    "review_kind": {
      "enum": [
        "initial",
        "delta"
      ]
    },
    "authorisation": {
      "$ref": "#/$defs/authorisation"
    },
    "confidentiality": {
      "$ref": "#/$defs/confidentiality"
    },
    "review_only": {
      "const": true
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input_artifact"
      }
    },
    "source_pdf_alignment": {
      "$ref": "#/$defs/source_pdf_alignment"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "venue_profile": {
      "$ref": "#/$defs/venue_profile"
    },
    "runtime_profile": {
      "$ref": "#/$defs/runtime_profile"
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "output_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "completion": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorisation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "authorised",
        "policy_status"
      ],
      "properties": {
        "capacity": {
          "enum": [
            "author_side",
            "official_reviewer"
          ]
        },
        "authorised": {
          "const": true
        },
        "policy_status": {
          "enum": [
            "permitted",
            "unknown",
            "prohibited"
          ]
        }
      }
    },
    "confidentiality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "processing",
        "external_transmission_authorised"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "author_owned_draft",
            "official_confidential_submission"
          ]
        },
        "processing": {
          "enum": [
            "local_only",
            "authorised_external"
          ]
        },
        "external_transmission_authorised": {
          "type": "boolean"
        }
      }
    },
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "lineage_id",
        "locator",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source",
            "pdf",
            "supplement",
            "data",
            "prior_ledger",
            "author_response"
          ]
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_pdf_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "source_only_verified",
            "pdf_only",
            "missing_pdf",
            "mismatch",
            "blocked"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue",
        "year",
        "track"
      ],
      "properties": {
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "track": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "venue_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile_id",
        "source_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "loaded",
            "blocked"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject_id",
        "proof_kind",
        "locator",
        "sha256"
      ],
      "properties": {
        "subject_kind": {
          "enum": [
            "root",
            "task"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "proof_kind": {
          "enum": [
            "adapter_dispatch_record",
            "host_loaded_profile_receipt"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_locator",
        "sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "evidence_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "promotion_reference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_locator",
        "sha256",
        "candidate_id",
        "adapter_sha256",
        "result",
        "promotion_decision"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_id": {
          "enum": [
            "minimal-settled-set",
            "persisted-task-registry"
          ]
        },
        "adapter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "promotion_decision": {
          "enum": [
            "selected",
            "not_selected",
            "rejected"
          ]
        }
      }
    },
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "host_build",
        "requested_model",
        "requested_mode",
        "configuration_source",
        "configuration_proof",
        "adapter_controlled_fallback",
        "selected_candidate_id",
        "adapter_sha256",
        "model_validation",
        "mode_validation",
        "promotion_evaluation_record",
        "effective_telemetry",
        "resolved_model",
        "resolved_mode",
        "compatibility_claim"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "host_build": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "const": "gpt-5.6-sol"
        },
        "requested_mode": {
          "const": "ultra"
        },
        "configuration_source": {
          "type": "string",
          "minLength": 1
        },
        "configuration_proof": {
          "$ref": "#/$defs/proof"
        },
        "adapter_controlled_fallback": {
          "const": "prohibited_and_checked"
        },
        "selected_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_validation": {
          "$ref": "#/$defs/validation_state"
        },
        "mode_validation": {
          "$ref": "#/$defs/validation_state"
        },
        "promotion_evaluation_record": {
          "$ref": "#/$defs/promotion_reference"
        },
        "effective_telemetry": {
          "enum": [
            "not_surfaced",
            "surfaced_unverified",
            "surfaced_and_verified"
          ]
        },
        "resolved_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility_claim": {
          "enum": [
            "evaluation_pending",
            "configured-and-evaluated",
            "runtime-attested"
          ]
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "coverage_risk_map",
        "task_count_as_runtime_observation",
        "tasks"
      ],
      "properties": {
        "owner": {
          "const": "root"
        },
        "coverage_risk_map": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "task_count_as_runtime_observation": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "substantive",
        "trigger",
        "task_effects",
        "requested_model",
        "requested_mode",
        "configuration_source",
        "configuration_proof",
        "adapter_controlled_fallback",
        "model_validation",
        "mode_validation",
        "fork_policy",
        "leaf_only",
        "descendant_state",
        "agent_or_task_identifier",
        "status",
        "report_artifact"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "substantive": {
          "type": "boolean"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "task_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "add_finding",
              "verify_finding",
              "remove_finding",
              "adjudicate_finding",
              "rank_finding",
              "synthesise_findings",
              "alter_completion",
              "extract_noncanonical_evidence",
              "format_report"
            ]
          }
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_proof": {
          "type": [
            "object",
            "null"
          ]
        },
        "adapter_controlled_fallback": {
          "enum": [
            "prohibited_and_checked",
            "not_applicable"
          ]
        },
        "model_validation": {
          "$ref": "#/$defs/validation_state"
        },
        "mode_validation": {
          "$ref": "#/$defs/validation_state"
        },
        "fork_policy": {
          "type": "string",
          "minLength": 1
        },
        "leaf_only": {
          "type": "boolean"
        },
        "descendant_state": {
          "enum": [
            "none",
            "unknown",
            "present"
          ]
        },
        "agent_or_task_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "report_artifact": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_sha256",
        "criteria"
      ],
      "properties": {
        "matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_row"
          }
        }
      }
    },
    "coverage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "applicability",
        "disposition",
        "evidence",
        "stage_id",
        "task_ids",
        "finding_ids",
        "rationale"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "applicable",
            "inapplicable",
            "uncertain"
          ]
        },
        "disposition": {
          "enum": [
            "assessed_no_finding",
            "finding_linked",
            "not_applicable",
            "needs_verification",
            "blocked"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "source_anchor"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "source_anchor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "status",
        "evidence"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "blocked"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
