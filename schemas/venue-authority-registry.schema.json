{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/venue-authority-registry.schema.json",
  "title": "Release-governed venue authority registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "checked_at",
    "venues"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "venue-authority-registry-v1"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "venue",
          "official_hosts",
          "profiles",
          "governance_note"
        ],
        "properties": {
          "venue": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "official_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9.-]+$"
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile_id",
                "profile_version",
                "year",
                "track",
                "profile_locator",
                "profile_sha256",
                "source_manifest_locator",
                "source_sha256"
              ],
              "properties": {
                "profile_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "profile_version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
                },
                "year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 2000
                },
                "track": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "profile_locator": {
                  "type": "string",
                  "pattern": "^venues/profiles/[A-Za-z0-9._/-]+\\.json$"
                },
                "profile_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "source_manifest_locator": {
                  "type": "string",
                  "pattern": "^venues/source-manifests/[A-Za-z0-9._/-]+\\.json$"
                },
                "source_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          },
          "governance_note": {
            "type": "string",
            "minLength": 20,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
