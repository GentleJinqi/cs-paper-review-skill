{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/review-coverage.schema.json",
  "title": "Canonical scientific review coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "criteria": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "review_question",
          "required_evidence",
          "primary_stage_owner",
          "conditional_specialist_trigger",
          "applicability_states",
          "required_when_inapplicable",
          "required_when_uncertain"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^RC-[A-Z0-9-]+$"
          },
          "review_question": {
            "type": "string",
            "minLength": 10,
            "pattern": "\\S"
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "pattern": "\\S"
            }
          },
          "primary_stage_owner": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[a-z0-9-]+$"
          },
          "conditional_specialist_trigger": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 3,
            "pattern": "\\S"
          },
          "applicability_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "applicable",
                "inapplicable",
                "uncertain"
              ]
            }
          },
          "required_when_inapplicable": {
            "type": "string",
            "minLength": 3,
            "pattern": "\\S"
          },
          "required_when_uncertain": {
            "type": "string",
            "minLength": 3,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
