{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/finding-ledger.schema.json",
  "title": "Scientific review finding ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "review_kind",
    "completion",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "review_kind": {
      "enum": [
        "initial",
        "delta"
      ]
    },
    "completion": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "review_kind",
        "prior_finding_id",
        "adjudication_status",
        "adjudication_rationale",
        "delta_status",
        "impact_change",
        "evidence_state",
        "criterion",
        "related_criteria",
        "decision_impact",
        "confidence",
        "claim",
        "evidence",
        "why_it_matters",
        "action_type",
        "closure_requirement",
        "dissent",
        "provenance"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F-[0-9a-f]{16}$"
        },
        "review_kind": {
          "enum": [
            "initial",
            "delta"
          ]
        },
        "prior_finding_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjudication_status": {
          "enum": [
            "candidate",
            "retained",
            "merged",
            "downgraded",
            "rejected",
            "unresolved"
          ]
        },
        "adjudication_rationale": {
          "type": "string",
          "minLength": 1
        },
        "delta_status": {
          "enum": [
            "not_applicable",
            "resolved",
            "partially_resolved",
            "still_open",
            "new",
            "made_worse"
          ]
        },
        "impact_change": {
          "enum": [
            "not_applicable",
            "unchanged",
            "upgraded",
            "downgraded"
          ]
        },
        "evidence_state": {
          "enum": [
            "verified",
            "needs_verification",
            "blocked"
          ]
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "related_criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_impact": {
          "enum": [
            "fundamental",
            "material",
            "limited",
            "advisory",
            "none"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "source_anchor",
            "semantic_anchor",
            "observation"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "source_anchor": {
              "type": "string",
              "minLength": 1
            },
            "semantic_anchor": {
              "type": "string",
              "minLength": 1
            },
            "observation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "enum": [
            "author-judgement",
            "author-data",
            "experiment-required",
            "citation-required",
            "prose-repair",
            "method-clarification",
            "analysis-repair",
            "figure-layout-repair",
            "submission-packaging",
            "no-action"
          ]
        },
        "closure_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "owner",
            "gate",
            "requirement"
          ],
          "properties": {
            "state": {
              "enum": [
                "open",
                "closed",
                "not_applicable"
              ]
            },
            "owner": {
              "enum": [
                "author",
                "reviewer",
                "external",
                "none"
              ]
            },
            "gate": {
              "enum": [
                "none",
                "author_judgement",
                "author_data",
                "experiment",
                "citation",
                "verification",
                "prose",
                "method",
                "analysis",
                "figure_layout",
                "packaging"
              ]
            },
            "requirement": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "dissent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "summary"
          ],
          "properties": {
            "state": {
              "enum": [
                "none",
                "recorded",
                "unresolved"
              ]
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_artifact_lineage_id",
            "originating_task_ids",
            "merged_from_ids",
            "merged_into_finding_id"
          ],
          "properties": {
            "primary_artifact_lineage_id": {
              "type": "string",
              "minLength": 1
            },
            "originating_task_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "merged_from_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "merged_into_finding_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_kind": {
                "const": "initial"
              }
            }
          },
          "then": {
            "properties": {
              "prior_finding_id": {
                "const": null
              },
              "delta_status": {
                "const": "not_applicable"
              },
              "impact_change": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_kind": {
                "const": "delta"
              },
              "delta_status": {
                "const": "new"
              }
            }
          },
          "then": {
            "properties": {
              "prior_finding_id": {
                "const": null
              },
              "impact_change": {
                "const": "not_applicable"
              }
            }
          }
        }
      ]
    }
  }
}

