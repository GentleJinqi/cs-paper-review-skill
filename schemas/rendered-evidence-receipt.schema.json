{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/rendered-evidence-receipt.schema.json",
  "title": "Finding- or criterion-specific rendered evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "recorded_at",
    "subject_id",
    "artifact_id",
    "pdf_sha256",
    "render_tool",
    "render_tool_version",
    "render_dpi",
    "render_format",
    "page_count",
    "page",
    "region",
    "rendered_artifact_locator",
    "rendered_artifact_sha256",
    "observation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_kind": {
      "const": "rendered_evidence"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pdf_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "render_tool": {
      "const": "pdftoppm"
    },
    "render_tool_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "render_dpi": {
      "const": 72
    },
    "render_format": {
      "const": "png"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "properties": {
        "x0": {
          "type": "number",
          "minimum": 0
        },
        "y0": {
          "type": "number",
          "minimum": 0
        },
        "x1": {
          "type": "number",
          "minimum": 0
        },
        "y1": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rendered_artifact_locator": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rendered_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
