{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cs-paper-review/venue-corpus-manifest.schema.json",
  "title": "Evidence-graded venue paper corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "purpose",
    "target",
    "inclusion_boundary",
    "rights_boundary",
    "search",
    "saturation",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose": {
      "enum": [
        "venue-background",
        "topic-near"
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "inclusion_boundary": {
      "$ref": "#/$defs/inclusion_boundary"
    },
    "rights_boundary": {
      "$ref": "#/$defs/rights_boundary"
    },
    "search": {
      "$ref": "#/$defs/search"
    },
    "saturation": {
      "$ref": "#/$defs/saturation"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue",
        "year",
        "track"
      ],
      "properties": {
        "venue": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2000
        },
        "track": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inclusion_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_statuses",
        "topic_dimensions",
        "notes"
      ],
      "properties": {
        "decision_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/status"
          }
        },
        "topic_dimensions": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "problem_family",
              "contribution_type",
              "mechanism_family",
              "claim_types",
              "evidence_structures",
              "modality_applications"
            ]
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "rights_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_only",
        "manuscript_bytes_stored",
        "notes"
      ],
      "properties": {
        "metadata_only": {
          "const": true
        },
        "manuscript_bytes_stored": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "sources",
        "deduplication_key",
        "screened_count",
        "included_count"
      ],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "source_type"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "source_type": {
                "enum": [
                  "official-program",
                  "official-proceedings",
                  "official-decision-record",
                  "venue-authorised-platform",
                  "bibliographic-index",
                  "author-record",
                  "discovery-only"
                ]
              }
            }
          }
        },
        "deduplication_key": {
          "enum": [
            "doi-or-title-year",
            "official-paper-id-or-title-year"
          ]
        },
        "screened_count": {
          "type": "integer",
          "minimum": 0
        },
        "included_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stopping_rule",
        "latest_batch",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "saturated",
            "not-saturated",
            "unknown"
          ]
        },
        "stopping_rule": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\S"
        },
        "latest_batch": {
          "$ref": "#/$defs/batch"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "query_sha256",
        "screened_count",
        "included_count",
        "marginal_additions",
        "evidence_artifact_ids"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "screened_count": {
          "type": "integer",
          "minimum": 0
        },
        "included_count": {
          "type": "integer",
          "minimum": 0
        },
        "marginal_additions": {
          "$ref": "#/$defs/marginal_additions"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "marginal_additions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_papers",
        "problem_family",
        "contribution_type",
        "mechanism_family",
        "claim_types",
        "evidence_structures",
        "modality_applications"
      ],
      "properties": {
        "eligible_papers": {
          "type": "integer",
          "minimum": 0
        },
        "problem_family": {
          "type": "integer",
          "minimum": 0
        },
        "contribution_type": {
          "type": "integer",
          "minimum": 0
        },
        "mechanism_family": {
          "type": "integer",
          "minimum": 0
        },
        "claim_types": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_structures": {
          "type": "integer",
          "minimum": 0
        },
        "modality_applications": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "withdrawn",
        "submitted",
        "camera-ready",
        "unknown"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "title",
        "status",
        "status_source_url",
        "status_source_type",
        "evidence_grade",
        "eligible_for_material_inference",
        "topic_signature",
        "similarity_assessment",
        "metadata_sha256"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "status_source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "status_source_type": {
          "enum": [
            "official-program",
            "official-proceedings",
            "official-decision-record",
            "venue-authorised-platform",
            "bibliographic-index",
            "author-record",
            "unverified"
          ]
        },
        "evidence_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "eligible_for_material_inference": {
          "type": "boolean"
        },
        "topic_signature": {
          "$ref": "#/$defs/topic_signature"
        },
        "similarity_assessment": {
          "$ref": "#/$defs/similarity_assessment"
        },
        "metadata_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "topic_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_family",
        "contribution_type",
        "mechanism_family",
        "claim_types",
        "evidence_structures",
        "modality_applications"
      ],
      "properties": {
        "problem_family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "contribution_type": {
          "enum": [
            "theory",
            "method",
            "benchmark",
            "system",
            "analysis",
            "dataset",
            "application",
            "unknown"
          ]
        },
        "mechanism_family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claim_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "comparative",
              "causal",
              "theoretical",
              "robustness",
              "generalisation",
              "efficiency",
              "resource",
              "safety",
              "empirical",
              "descriptive",
              "unknown"
            ]
          }
        },
        "evidence_structures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "benchmark",
              "ablation",
              "theory",
              "user-study",
              "case-study",
              "simulation",
              "real-world",
              "qualitative",
              "artifact-release",
              "unknown"
            ]
          }
        },
        "modality_applications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "similarity_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "axis_comparison",
        "rationale"
      ],
      "properties": {
        "state": {
          "enum": [
            "near",
            "not-near",
            "not-assessed",
            "unknown"
          ]
        },
        "axis_comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem_family",
            "contribution_type",
            "mechanism_family",
            "claim_types",
            "evidence_structures",
            "modality_applications"
          ],
          "properties": {
            "problem_family": {
              "$ref": "#/$defs/axis_state"
            },
            "contribution_type": {
              "$ref": "#/$defs/axis_state"
            },
            "mechanism_family": {
              "$ref": "#/$defs/axis_state"
            },
            "claim_types": {
              "$ref": "#/$defs/axis_state"
            },
            "evidence_structures": {
              "$ref": "#/$defs/axis_state"
            },
            "modality_applications": {
              "$ref": "#/$defs/axis_state"
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "axis_state": {
      "enum": [
        "match",
        "partial",
        "different",
        "unknown",
        "not-assessed"
      ]
    }
  }
}
